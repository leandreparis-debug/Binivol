{
  "name": "binivol",
  "version": "0.1.0",
  "private": true,
  "description": "Gestion des bénévoles de l'unité locale de Versailles de la Croix-Rouge française",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/vercel-build.ts",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "pnpm db:fresh",
    "db:seed": "pnpm db:seed:demo",
    "db:studio": "prisma studio",
    "icons": "tsx scripts/generate-icons.ts",
    "docs:permissions": "tsx scripts/generate-permissions-doc.ts",
    "admin:grant": "tsx scripts/admin.ts grant",
    "admin:revoke": "tsx scripts/admin.ts revoke",
    "db:seed:base": "tsx prisma/seed.ts base",
    "db:seed:demo": "tsx prisma/seed.ts demo",
    "db:fresh": "tsx scripts/db-fresh.ts",
    "import:classeur": "tsx scripts/import-classeur.ts",
    "fixtures:classeur": "tsx scripts/make-fixture-classeur.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1153.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "clsx": "^2.1.1",
    "exceljs": "4.4.0",
    "geist": "^1.9.0",
    "lucide-react": "^1.68.0",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.2.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
