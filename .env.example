# Copie ce fichier en `.env` (jamais commité) et adapte les valeurs.
# Aucune de ces variables ne doit contenir de donnée réelle de bénévole.

# Nom affiché de l'application (titre, en-tête). Optionnel, défaut : « Binivol ».
NEXT_PUBLIC_APP_NAME=Binivol

# URL publique de l'application, sans slash final (ex. https://binivol.example.org).
# Optionnelle à cette étape ; servira aux liens dans les mails et aux PDF.
# APP_URL=http://localhost:3000

# Active la page /design en production (elle est toujours accessible en développement).
# Valeurs acceptées : true / false. Défaut : false.
# ENABLE_DESIGN_PAGE=false

# --- Docker Compose uniquement -------------------------------------------------
# Mot de passe du service PostgreSQL local (docker-compose.yml). Choisis une valeur
# aléatoire ; la base n'est pas encore utilisée par l'application (étape 2).
POSTGRES_PASSWORD=change-me
POSTGRES_USER=binivol
POSTGRES_DB=binivol
