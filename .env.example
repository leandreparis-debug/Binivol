# Copie ce fichier en `.env` (jamais commité) et adapte les valeurs.
# Aucune de ces variables ne doit contenir de donnée réelle de bénévole.

# Nom affiché de l'application (titre, en-tête). Optionnel, défaut : « Binivol ».
NEXT_PUBLIC_APP_NAME=Binivol

# URL publique de l'application, sans slash final (ex. https://binivol.example.org).
# Optionnelle à cette étape ; servira aux liens dans les mails et aux PDF.
# APP_URL=http://localhost:3000

# Active la page /design en production (elle est toujours accessible en développement).
# Valeurs acceptées : true / false. Défaut : false.
# ENABLE_DESIGN_PAGE=false

# --- Base de données (PostgreSQL standard) -------------------------------------
# Connexion utilisée par l'application. Peut passer par un pooler.
#   Docker local : postgresql://binivol:<POSTGRES_PASSWORD>@localhost:5432/binivol
#   Supabase (utilisé seulement comme Postgres) : pooler en mode transaction,
#   port 6543, avec pgbouncer=true et SSL :
#   postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<région>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# Absente : le build passe, le serveur signale l'absence au démarrage et toute
# requête échoue avec un message explicite.
DATABASE_URL=postgresql://binivol:change-me@localhost:5432/binivol

# Connexion directe, utilisée par les migrations (prisma migrate) : jamais via
# le pooler.
#   Docker local : identique à DATABASE_URL.
#   Supabase : port 5432 (connexion directe ou pooler en mode session).
DIRECT_URL=postgresql://binivol:change-me@localhost:5432/binivol

# Optionnelle. Base « fantôme » pour `pnpm db:migrate` quand l'utilisateur ne
# peut pas créer de base temporaire (cas de Supabase). Inutile en local Docker.
# SHADOW_DATABASE_URL=postgresql://binivol:change-me@localhost:5432/binivol_shadow

# Base des tests d'intégration (pnpm test:db). Son nom doit contenir « test » :
# elle est entièrement effacée à chaque exécution. Service `db-test` de Docker.
TEST_DATABASE_URL=postgresql://binivol:binivol@localhost:5433/binivol_test

# Base des tests end-to-end (pnpm test:e2e), migrée et seedée avant chaque exécution.
# Optionnelle : à défaut, DATABASE_URL est utilisée (déconseillé, les tests créent des comptes).
# E2E_DATABASE_URL=postgresql://binivol:change-me@localhost:5432/binivol_e2e

# --- Connexion (Auth.js) — voir docs/auth.md ---------------------------------------
# Secret d'Auth.js, 32 caractères minimum : `openssl rand -base64 32`. Obligatoire en production.
AUTH_SECRET=
# URL publique de l'application, si elle ne se déduit pas de la requête (proxy, VPS).
# AUTH_URL=https://binivol.exemple.org
# Client OAuth Google (console Google Cloud). Sans ces deux valeurs, le bouton Google est désactivé.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Seules les adresses de ce domaine peuvent se connecter. Défaut : croix-rouge.fr.
# AUTH_ALLOWED_DOMAIN=croix-rouge.fr
# Connexion de démonstration avec les comptes @binivol.test du seed (développement, tests e2e).
# Valeurs : true / false. Défaut : false. INTERDITE sur Vercel : si VERCEL_ENV est défini, le
# serveur refuse de démarrer.
# AUTH_DEMO_LOGIN=false
# Prévisualisations Vercel uniquement : URL du proxy de redirection OAuth (voir docs/auth.md).
# AUTH_REDIRECT_PROXY_URL=https://binivol.exemple.org/api/auth

# --- Docker Compose uniquement -------------------------------------------------
# Service PostgreSQL de développement (docker-compose.yml). Choisis un mot de
# passe aléatoire et reporte-le dans DATABASE_URL et DIRECT_URL ci-dessus.
POSTGRES_PASSWORD=change-me
POSTGRES_USER=binivol
POSTGRES_DB=binivol
# Ports publiés sur localhost : base de développement et base de test.
# POSTGRES_PORT=5432
# POSTGRES_TEST_PORT=5433
