# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: only .env.example is committed
.env
.env.*
!.env.example

# vercel
.vercel

# prisma client (generated by `prisma generate`, run on postinstall)
/src/generated/

# typescript
*.tsbuildinfo
next-env.d.ts

# docker
/docker-data

# spreadsheets: the real legacy workbook (C3) must never enter the repository;
# only the synthetic fixtures of tests/fixtures/ are committed
*.xlsx
*.xls
!tests/fixtures/*.xlsx
